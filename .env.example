# Copy this file to .env beside server.mjs and configure the SQL Server connection.
# Use localhost when SQL Server is on this PC; otherwise use its hostname or IP.
SQL_SERVER=localhost
SQL_DATABASE=SchoolDW
SQL_DRIVER=ODBC Driver 17 for SQL Server
# Local development only: use true for an untrusted/self-signed SQL Server certificate.
SQL_TRUST_SERVER_CERTIFICATE=true
# Set SQL_AUTH=windows to use the Windows account running the API instead.
SQL_AUTH=sql
SQL_USER=
SQL_PASSWORD=
COMPASS_PROXY_PORT=4201
COMPASS_PHOTOS_DIR=C:\Sanits\CompassPhotos
# Opt in only for local development. The staff selector is loopback-only.
WELLBEING_DEV_AUTH=false
